{
  "name": "pointblock-fps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PointBlock FPS — Vite-based modular frontend with the original Three.js r128 gameplay",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/build.mjs && node --test",
    "test:integration": "node --test tests/vite-integration.test.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "verify": "npm run test && npm run build && npm run check:dist",
    "test:ci": "node tools/build.mjs --check && node tools/active-ci-tests.mjs",
    "test:full": "npm test"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "three": "0.128.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.90.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.38.2",
    "wagmi": "^2.15.0"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
