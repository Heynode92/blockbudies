# Browser-visible backend origin only; no secrets.
VITE_POINTBLOCK_API_URL=http://127.0.0.1:3001

# RainbowKit WalletConnect Cloud project ID (public identifier, not a secret).
# Obtain from https://cloud.reown.com/ ; leave blank to disable login safely.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional public Robinhood Chain Mainnet RPC; blank uses the official public endpoint.
# Must report chain ID 4663 (0x1237); never use testnet 46630.
# Browser-visible VITE_* values must NOT contain private RPC credentials.
VITE_ROBINHOOD_RPC_URL=
